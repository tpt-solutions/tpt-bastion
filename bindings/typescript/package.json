{
  "name": "bastion",
  "version": "0.1.0",
  "description": "TypeScript bindings for TPT Bastion — author infrastructure in TypeScript and drive the bastion CLI",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "iac",
    "infrastructure",
    "terraform",
    "bastion",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tpt/bastion.git",
    "directory": "bindings/typescript"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node scripts/gen-ir-version.mjs && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "example": "node --experimental-strip-types examples/aws_s3.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}
