config {
    region = "ap-southeast-2"
}

variable environment {
    type = "string"
    default = "dev"
}
resource aws_s3_bucket assets {
    bucket = "demo-assets"
    acl = "private"
    versioning {
        enabled = true
    }
    tags = { environment = "dev", team = "platform" }
}
resource aws_s3_bucket backup {
    bucket = assets.bucket
}
output assets_bucket {
    value = assets.bucket
}
